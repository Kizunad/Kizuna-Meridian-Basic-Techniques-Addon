# 数值为占位；费用是整式总额，按已绑定经脉均分。
schema_version: 1
namespace: "meridian_basic_techniques"
binding_templates { id: "human:adult" version: 1 }
books { id: "meridian_basic_techniques:basic" display_name: "基础功法" }
volumes {
  id: "meridian_basic_techniques:breath_volume"
  book_id: "meridian_basic_techniques:basic"
  display_name: "调息卷"
  techniques { id: "meridian_basic_techniques:breath" version: 1 }
}
volumes {
  id: "meridian_basic_techniques:light_step_volume"
  book_id: "meridian_basic_techniques:basic"
  display_name: "轻步卷"
  techniques { id: "meridian_basic_techniques:light_step" version: 1 }
}
volumes {
  id: "meridian_basic_techniques:charge_volume"
  book_id: "meridian_basic_techniques:basic"
  display_name: "蓄力卷"
  techniques { id: "meridian_basic_techniques:charge" version: 1 }
}

definitions {
  id: "meridian_basic_techniques:breath"
  version: 1
  category: RECOVERY
  minimum_realm: WANDERING_QI
  slots {
    id: "source"
    module: MERIDIAN
    tags: "human:layer_wandering_qi"
    minimum_count: 1
    maximum_count: 16
    require_opened: true
  }
  slots {
    id: "breathing"
    module: TISSUE
    tags: "human:breathing"
    minimum_count: 1
    maximum_count: 16
  }
  slots {
    id: "arms"
    module: TISSUE
    tags: "human:arm_muscle"
    minimum_count: 1
    maximum_count: 16
  }
  slots {
    id: "legs"
    module: TISSUE
    tags: "human:leg_muscle"
    minimum_count: 1
    maximum_count: 16
  }
  cost {
    qi {
      slot_id: "source"
      phase: FREE
      matching: ANY_ATTRIBUTE_AT_LEAST_PHASE
      amount { value: 10 unit: QI }
      distribution: EVEN
    }
  }
  phases {
    warmup_millis: 1100
    active_millis: 0
    recovery_millis: 900
    interruptible_by_damage: true
  }
  cooldown_millis: 20000
  effects {
    at_millis: 0
    presentation {
      id: "meridian_basic_techniques:technique_breath"
      duration: UNTIL_RECOVERY_END
      start_millis: 0
    }
  }
  effects {
    at_millis: 0
    sound {
      sound_id: "minecraft:entity.player.breath"
      volume { value: 0.6 unit: RATIO }
      pitch { value: 0.8 unit: RATIO }
      anchor: CASTER
    }
  }
  effects {
    at_millis: 1100
    tissue_modifier {
      slot_id: "arms"
      curve { offset_millis: 0 value: 0 }
      curve { offset_millis: 2000 value: 1 }
      curve { offset_millis: 8000 value: 1 }
      curve { offset_millis: 20000 value: 0 }
      strength_peak { value: 1 unit: RATIO }
      burst_peak { value: 1 unit: RATIO }
      endurance_peak { value: 1 unit: RATIO }
      recovery_peak { value: 4 unit: RATIO }
    }
  }
  effects {
    at_millis: 1100
    tissue_modifier {
      slot_id: "legs"
      curve { offset_millis: 0 value: 0 }
      curve { offset_millis: 2000 value: 1 }
      curve { offset_millis: 8000 value: 1 }
      curve { offset_millis: 20000 value: 0 }
      strength_peak { value: 1 unit: RATIO }
      burst_peak { value: 1 unit: RATIO }
      endurance_peak { value: 1 unit: RATIO }
      recovery_peak { value: 4 unit: RATIO }
    }
  }
  effects {
    at_millis: 1100
    sound {
      sound_id: "minecraft:block.amethyst_block.chime"
      volume { value: 0.5 unit: RATIO }
      pitch { value: 0.7 unit: RATIO }
      anchor: CASTER
    }
  }
  ai_hints {
    minimum_distance { value: 12 unit: METER }
    maximum_distance { value: 1024 unit: METER }
    maximum_hp_ratio { value: 1 unit: RATIO }
    minimum_qi_ratio { value: 0 unit: RATIO }
    category_weight { value: 1 unit: RATIO }
    support {
      role: AI_ROLE_RECOVER
      minimum_fatigue_ratio { value: 0.3 unit: RATIO }
    }
  }
  presentation {
    icon_id: "meridian_basic_techniques:breath"
    display_name: "调息"
    description: "调匀呼吸，逐渐提高双臂与双腿的恢复能力。适合交战间隙使用，起手期间受到足以造成僵直的伤害会中断。"
  }
}

definitions {
  id: "meridian_basic_techniques:light_step"
  version: 1
  category: BUFF
  minimum_realm: WANDERING_QI
  slots {
    id: "source"
    module: MERIDIAN
    tags: "human:foot_meridian"
    minimum_count: 1
    maximum_count: 16
    require_opened: true
  }
  slots {
    id: "legs"
    module: TISSUE
    tags: "human:leg_muscle"
    minimum_count: 6
    maximum_count: 6
  }
  cost {
    qi {
      slot_id: "source"
      phase: FREE
      matching: ANY_ATTRIBUTE_AT_LEAST_PHASE
      amount { value: 15 unit: QI }
      distribution: EVEN
    }
  }
  phases {
    warmup_millis: 280
    active_millis: 0
    recovery_millis: 200
    interruptible_by_damage: false
  }
  cooldown_millis: 3000
  effects {
    at_millis: 280
    status_benefit {
      id: "meridian_basic_techniques:light_body"
      duration_millis: 20000
      color_rgb: 11977153
      leap {
        work {
          slot_id: "legs"
          force { value: 0 unit: NEWTON }
          power { value: 133.33333333333334 unit: WATT }
          duration { value: 0.5 unit: SECOND }
        }
        maximum_rise: 3
        maximum_drop: 4
        snap_radius: 2
        landing_delay_ticks: 6
        presentation_id: "meridian_basic_techniques:technique_dash"
        ai_minimum_distance: 4
        ai_decision_ticks: 6
        failure_translation_key: "message.meridian_basic_techniques.weak_legs"
        maximum_path: 7
        launch_speed: 12
        minimum_flight_ticks: 6
        maximum_flight_ticks: 30
        takeoff_sound {
          sound_id: "minecraft:entity.rabbit.jump"
          volume { value: 0.6 unit: RATIO }
          pitch { value: 0.7 unit: RATIO }
          pitch_jitter { value: 0.05 unit: RATIO }
          anchor: CASTER
        }
      }
    }
  }
  effects {
    at_millis: 280
    sound {
      sound_id: "minecraft:block.amethyst_block.chime"
      volume { value: 0.4 unit: RATIO }
      pitch { value: 0.9 unit: RATIO }
      anchor: CASTER
    }
  }
  ai_hints {
    minimum_distance { value: 4 unit: METER }
    maximum_distance { value: 24 unit: METER }
    maximum_hp_ratio { value: 1 unit: RATIO }
    minimum_qi_ratio { value: 0.1 unit: RATIO }
    category_weight { value: 1.5 unit: RATIO }
    support {
      role: AI_ROLE_REPOSITION
      order: 2
      refresh_before_expiry_millis: 3000
    }
  }
  presentation {
    icon_id: "meridian_basic_techniques:light_step"
    display_name: "轻步"
    description: "施展后一段时间内身轻如燕，可连续向准星处远跃，翻上两三格高处。潜行时仍可普通跳跃，腿脚乏力时需稍作休息。"
  }
}

definitions {
  id: "meridian_basic_techniques:charge"
  version: 1
  category: BUFF
  minimum_realm: WANDERING_QI
  slots {
    id: "source"
    module: MERIDIAN
    tags: "human:hand_meridian"
    minimum_count: 1
    maximum_count: 16
    require_opened: true
  }
  slots {
    id: "arms"
    module: TISSUE
    tags: "human:arm_muscle"
    minimum_count: 1
    maximum_count: 16
  }
  cost {
    qi {
      slot_id: "source"
      phase: FREE
      matching: ANY_ATTRIBUTE_AT_LEAST_PHASE
      amount { value: 15 unit: QI }
      distribution: EVEN
    }
  }
  phases {
    warmup_millis: 1600
    active_millis: 0
    recovery_millis: 400
    interruptible_by_damage: true
  }
  cooldown_millis: 10000
  effects {
    at_millis: 0
    presentation {
      id: "meridian_basic_techniques:technique_charge"
      duration: UNTIL_RECOVERY_END
      start_millis: 0
    }
  }
  effects {
    at_millis: 0
    sound {
      sound_id: "minecraft:entity.player.breath"
      volume { value: 0.5 unit: RATIO }
      pitch { value: 0.6 unit: RATIO }
      anchor: CASTER
    }
  }
  effects {
    at_millis: 1600
    tissue_modifier {
      slot_id: "arms"
      curve { offset_millis: 0 value: 0 }
      curve { offset_millis: 1500 value: 1 }
      curve { offset_millis: 2500 value: 1 }
      curve { offset_millis: 5000 value: 0 }
      curve { offset_millis: 6000 value: -0.5 }
      curve { offset_millis: 9000 value: -0.5 }
      curve { offset_millis: 10000 value: 0 }
      strength_peak { value: 1.3 unit: RATIO }
      burst_peak { value: 1.3 unit: RATIO }
      endurance_peak { value: 1 unit: RATIO }
      recovery_peak { value: 1 unit: RATIO }
    }
  }
  effects {
    at_millis: 1600
    sound {
      sound_id: "minecraft:entity.experience_orb.pickup"
      volume { value: 0.3 unit: RATIO }
      pitch { value: 0.5 unit: RATIO }
      anchor: CASTER
    }
  }
  ai_hints {
    minimum_distance { value: 4 unit: METER }
    maximum_distance { value: 24 unit: METER }
    maximum_hp_ratio { value: 1 unit: RATIO }
    minimum_qi_ratio { value: 0.2 unit: RATIO }
    category_weight { value: 1 unit: RATIO }
    support {
      role: AI_ROLE_PREPARE
      order: 1
      requires_melee_weapon: true
    }
  }
  presentation {
    icon_id: "meridian_basic_techniques:charge"
    display_name: "蓄力"
    description: "凝聚双臂的力量，短时间提高力量与爆发。效果退去后会有一段乏力期，适合在进攻前准备。"
  }
}
